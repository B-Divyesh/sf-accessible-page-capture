{
  "name": "accessible-page-capture",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:site": "vite --config site/vite.config.ts",
    "build:extension": "wxt build && wxt zip",
    "build:site": "vite build --config site/vite.config.ts",
    "build": "npm run build:extension && npm run build:site && node scripts/copy-extension.mjs",
    "test:unit": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "test": "npm run test:unit && npm run test:e2e",
    "check": "tsc --noEmit"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "1.58.2",
    "@types/chrome": "0.0.322",
    "playwright-core": "1.58.2",
    "typescript": "5.9.2",
    "vite": "7.1.3",
    "vitest": "3.2.4",
    "wxt": "0.20.6"
  }
}
