{
  "name": "accessible-page-capture",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "wxt prepare",
    "dev": "wxt",
    "dev:site": "vite --config site/vite.config.ts",
    "build:extension": "wxt build && wxt zip",
    "build:site": "npm run build:extension && vite build --config site/vite.config.ts && node scripts/copy-extension.mjs",
    "build": "npm run build:site",
    "test:unit": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "test": "npm run test:unit && npm run test:e2e && npm run test:package",
    "test:package": "node scripts/test-package.mjs",
    "check": "tsc --noEmit"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "1.58.2",
    "@types/chrome": "0.0.322",
    "playwright-core": "1.58.2",
    "typescript": "5.9.2",
    "vite": "7.3.6",
    "vitest": "3.2.7",
    "wxt": "0.21.4"
  }
}
